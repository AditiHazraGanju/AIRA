# Aira environment variables.
# Copy this file to .env.local and replace every YOUR_* placeholder:
#   cp .env.example .env.local
# Next.js inlines NEXT_PUBLIC_* values at build time and ships them to the
# browser, so set them before `npm run build` and never put a server-side
# secret in one.

# ── Backend API ───────────────────────────────────────────────────────────
# Base URL of saathi-laravel-api, including the /api/v1 suffix, no trailing slash.
# Format: https://<api-host>/api/v1 (local: http://localhost:8000/api/v1).
# Get it from whoever runs the API for the environment you are building for.
NEXT_PUBLIC_API_BASE_URL=YOUR_API_BASE_URL

# ── Voice relay ───────────────────────────────────────────────────────────
# WebSocket URL of the healthtalk-relay service, ending in /ws.
# Format: wss://<relay-host>/ws in production (browsers block ws:// on https
# pages); ws://localhost:8080/ws when running the relay locally.
# Get it from the relay deployment; locally, use the PORT set in the relay's .env.
NEXT_PUBLIC_RELAY_WS_URL=YOUR_RELAY_WS_URL

# ── Remote logging (optional) ─────────────────────────────────────────────
# Client errors and events are sent to a TCM Logger (devlogx) endpoint. Logging
# stays off unless both NEXT_PUBLIC_TCMLOGGER_BASE_URL and
# NEXT_PUBLIC_TCMLOGGER_TOKEN are set; leave them empty to disable it.

# Logger API base URL, without the /process or /error endpoint suffix.
# Format: https://<logger-host>/api/v0/log
# Get it from the logging service's admin / documentation.
NEXT_PUBLIC_TCMLOGGER_BASE_URL=YOUR_TCMLOGGER_BASE_URL

# Logger access token, sent as the X-Devlog-Token header.
# Format: opaque string issued by the logging service (about 64 characters).
# Generate one in the logging service's project settings. It is visible in the
# browser bundle, so use a write-only token scoped to this app.
NEXT_PUBLIC_TCMLOGGER_TOKEN=YOUR_TCMLOGGER_TOKEN

# Organisation name the logger groups entries under.
# Format: free text, as registered with the logging service.
NEXT_PUBLIC_TCMLOGGER_CLIENT=YOUR_TCMLOGGER_CLIENT_NAME

# Domain recorded with each log entry (usually the API domain).
# Format: https://<domain>/
NEXT_PUBLIC_TCMLOGGER_DOMAIN=YOUR_TCMLOGGER_DOMAIN

# Application name recorded with each log entry. Defaults to "Aira".
# Format: free text.
NEXT_PUBLIC_TCMLOGGER_APP=Aira
