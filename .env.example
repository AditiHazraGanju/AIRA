# healthtalk-relay environment variables.
# Copy this file to .env and replace every YOUR_* placeholder:
#   cp .env.example .env
# .env is git-ignored. Never commit real values.

# ── Server ───────────────────────────────────────────────────────────────

# Port the HTTP/WebSocket server listens on (WebSocket path /ws, health check /healthz).
# Format: integer. Default 8080.
PORT=8080

# Browser origins allowed to open a socket, comma-separated, no trailing slash.
# Format: https://aira.example.com,https://staging.aira.example.com
# Leave empty to allow any origin (local development only). Use the URL(s) Aira is served from.
ALLOWED_ORIGINS=http://localhost:3000

# Log verbosity.
# Format: one of debug, info, warn, error. Default info.
LOG_LEVEL=info

# ── Auth ─────────────────────────────────────────────────────────────────

# Secret used to verify the HS256 JWTs that saathi-laravel-api issues at login.
# Format: the exact JWT_SECRET string from saathi-laravel-api's .env (tymon/jwt-auth,
# typically a 64-character random string).
# Retrieve it from that environment's saathi-laravel-api .env; it is created there with
# `php artisan jwt:secret`. It MUST be identical, or every user is rejected (close code 4003).
JWT_SECRET=YOUR_JWT_SECRET

# ── Laravel API (guardrails, Content Library search, saved conversations) ─

# Base URL of saathi-laravel-api, including /api/v1, no trailing slash.
# Format: https://<api-host>/api/v1 (local: http://localhost:8000/api/v1).
# Use the same API environment that issues the JWTs above.
LARAVEL_API_URL=YOUR_LARAVEL_API_URL

# How long guardrails are cached in memory before being fetched again.
# Format: integer seconds. Default 60.
GUARDRAIL_CACHE_SECONDS=60

# ── Google Cloud / Gemini Live ───────────────────────────────────────────

# Path to a Google Cloud service account key file (JSON) used for Vertex AI.
# Format: absolute file path, e.g. /etc/secrets/gcp-service-account.json
# Create it in Google Cloud Console > IAM & Admin > Service Accounts > (account) > Keys >
# Add key > JSON. The account needs the Vertex AI User role (roles/aiplatform.user).
# On Google Cloud (Cloud Run, GCE) you can leave this empty and attach the service
# account to the runtime instead.
GOOGLE_APPLICATION_CREDENTIALS=YOUR_SERVICE_ACCOUNT_KEY_PATH

# Google Cloud project that hosts Vertex AI and the service account above.
# Format: project ID (lowercase letters, digits and hyphens), not the project name or number.
# Find it in Google Cloud Console > project picker, or `gcloud config get-value project`.
GCP_PROJECT_ID=YOUR_GCP_PROJECT_ID

# Vertex AI region for Gemini Live. Live models are not served from asia-south1.
# Format: a Vertex AI region ID. Default us-central1.
GCP_LOCATION=us-central1

# Gemini Live model ID.
# Format: a Vertex AI model ID. Default gemini-live-2.5-flash-native-audio.
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio

# Optional prebuilt voice name; leave empty for the model default.
# Format: a Gemini prebuilt voice name, e.g. Aoede.
GEMINI_VOICE=

# ── Content Library search ───────────────────────────────────────────────

# Embedding model for search queries. Must match VERTEX_EMBEDDING_MODEL in
# saathi-laravel-api, which rejects vectors from any other model.
# Format: a Vertex AI embedding model ID. Default gemini-embedding-001.
EMBEDDING_MODEL=gemini-embedding-001

# Vertex AI region for embeddings (asia-south1 measured fastest from India).
# Format: a Vertex AI region ID. Default asia-south1.
EMBEDDING_LOCATION=asia-south1

# Give up on a library lookup after this long; Aira then says the library is unavailable.
# Format: integer milliseconds. Default 4000.
SEARCH_TIMEOUT_MS=4000

# ── Limits ───────────────────────────────────────────────────────────────

# Maximum simultaneous conversations; extra connections are refused (close code 1013).
# Format: integer. Default 50.
MAX_CONCURRENT_SESSIONS=50

# Hard cap on a single conversation's length (close code 4010).
# Format: integer minutes. Default 15.
MAX_SESSION_MINUTES=15

# Close the session if the client sends nothing for this long (close code 4008).
# Format: integer seconds. Default 120.
IDLE_TIMEOUT_SECONDS=120

# ── Test scripts only (npm run test:client, test/*.js) ───────────────────
# Optional. Uncomment to point the tests at a real login or another relay.

# A real JWT from an Aira login, used instead of one signed with JWT_SECRET.
# Format: a JWT string (three base64url parts separated by dots).
# Get it from the browser's localStorage key auth_token after logging in to Aira.
# TEST_TOKEN=YOUR_TEST_JWT

# User ID placed in test tokens signed with JWT_SECRET.
# Format: integer users.id from saathi-laravel-api. Default 1.
# TEST_USER_ID=1

# Relay URL the tests connect to. Default ws://localhost:<PORT>/ws.
# Format: ws:// or wss:// URL ending in /ws.
# RELAY_URL=ws://localhost:8080/ws

# Conversation language for the tests.
# Format: one of ENG, HIN, MAR, BEN. Default ENG.
# TEST_LANGUAGE=ENG
