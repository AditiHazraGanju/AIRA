# =============================================================================
# Aira API: environment settings
# Copy to .env and fill in every YOUR_* value. Never commit the real .env.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────

# Name shown in logs. Any text.
APP_NAME="Aira API"

# local | staging | production. In "local", the login OTP is always 102025 and
# no SMS or WhatsApp message is sent, so never use "local" on a public server.
APP_ENV=local

# Laravel encryption key, format "base64:<44 chars>". Generate: php artisan key:generate
# It is also the key for the encrypted mobile numbers in the users table: to
# read existing data, use the APP_KEY that encrypted it. Changing it later makes
# every stored mobile number unreadable, and those users can no longer log in.
APP_KEY=

# true only while developing; false on any shared server.
APP_DEBUG=true

# Public base URL of this API, no trailing slash, e.g. https://api.example.com
APP_URL=http://localhost:8000

# PHP timezone for timestamps, e.g. Asia/Kolkata
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# debug | info | warning | error
LOG_LEVEL=debug

# ── Database (PostgreSQL 15+ with the pgvector extension) ────────────────────
DB_CONNECTION=pgsql
# Database server host name or IP.
DB_HOST=127.0.0.1
DB_PORT=5432
# Name of the Aira database (the one reduced to 27 tables), e.g. aira_db
DB_DATABASE=YOUR_DATABASE_NAME
# A database user that can read and write that database.
DB_USERNAME=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Sessions, cache and queue live in the sessions, cache and jobs tables.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Aira sends no email; "log" writes any mail to the log file.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Aira user login (JWT) ────────────────────────────────────────────────────

# Signs the tokens Aira users get after the OTP login (HS256). A long random
# string. Generate: php artisan jwt:secret   (or: openssl rand -base64 48)
# The Aira web app and healthtalk-relay only pass the token back and do not
# need this value. Changing it logs every user out.
JWT_SECRET=YOUR_JWT_SECRET

# Token lifetime in minutes (525600 = 1 year).
JWT_TTL=525600

# ── Admin panel ──────────────────────────────────────────────────────────────

# Shared secret the admin panel sends in the X-Admin-Key header. It must equal
# ADMIN_API_KEY in the admin panel's .env. Generate: openssl rand -hex 32
# If left empty, every admin endpoint answers 401.
ADMIN_API_KEY=YOUR_ADMIN_API_KEY

# ── Login OTP delivery (SMS Gateway Hub, https://www.smsgatewayhub.com) ──────
# Not used when APP_ENV=local. The keys are in the SMS Gateway Hub dashboard.

# SMS send endpoint.
SMSGATEWAYHUB_SMS_URL=https://www.smsgatewayhub.com/api/mt/SendSMS
# API key for SMS.
SMSGATEWAYHUB_SMS_API_KEY=YOUR_SMS_API_KEY
# DLT-approved 6-letter sender ID, e.g. ABCDEF
SMSGATEWAYHUB_SENDER_ID=YOUR_SENDER_ID
# WhatsApp send endpoint, from the SMS Gateway Hub WhatsApp API docs.
SMSGATEWAYHUB_MESSAGE_URL=YOUR_WHATSAPP_API_URL
# API key for WhatsApp.
SMSGATEWAYHUB_DEV_API_KEY=YOUR_WHATSAPP_API_KEY
# Name of the approved WhatsApp OTP template.
SMSGATEWAYHUB_WHATSAPP_OTP_TEMPLATE=saathi_otp

# ── Google Cloud (Vertex AI, Cloud Storage, Text-to-Speech) ──────────────────

# Google Cloud project ID (the ID, not the number), e.g. my-project-123456
GOOGLE_CLOUD_PROJECT_ID=YOUR_GCP_PROJECT_ID

# Absolute path to a service-account JSON key. Create it in Cloud Console:
# IAM & Admin > Service Accounts > Keys > Add key > JSON. The account needs
# Vertex AI User, Storage Object Admin on the bucket, and Text-to-Speech access.
# Keep the file outside public/ and out of git.
GOOGLE_CLOUD_KEY_FILE=/absolute/path/to/service-account.json

# The same path, read by the Google client libraries (Text-to-Speech).
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Cloud Storage bucket for Content Library uploads and start-pitch audio.
# The bucket name only, without gs://
GOOGLE_CLOUD_STORAGE_BUCKET=YOUR_GCS_BUCKET

# Vertex AI region and models for Content Library indexing and search.
# The embedding model must match the relay's EMBEDDING_MODEL; changing it
# means re-indexing: php artisan healthtalk:index-content --all
VERTEX_LOCATION=asia-south1
VERTEX_EMBEDDING_MODEL=gemini-embedding-001
VERTEX_EXTRACTION_MODEL=gemini-2.5-flash

# ── Remote API logging (optional, TCM logger) ────────────────────────────────
# true sends API logs to the TCM logger; false turns it off. The values come
# from the logger's admin.
TCMLOGGER_DEBUG=false
TCMLOGGER_BASEURL=YOUR_TCMLOGGER_BASE_URL
TCMLOGGER_LOG_ENV=local
TCMLOGGER_CLIENT=YOUR_TCMLOGGER_CLIENT
TCMLOGGER_DOMAIN=YOUR_TCMLOGGER_DOMAIN
TCMLOGGER_APP=YOUR_TCMLOGGER_APP
TCMLOGGER_TOKEN=YOUR_TCMLOGGER_TOKEN
