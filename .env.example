# =============================================================================
# Aira admin panel: environment settings
# Copy to .env and fill in every YOUR_* value. Never commit the real .env.
#
# The admin panel has no login. Anyone who can reach it can edit the content
# library, guardrails and start pitch, and read every conversation. Run it on a
# private network, behind a VPN, or behind your web server's own authentication.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────

# Name shown in the browser tab. Any text.
APP_NAME="Aira Admin"

# local | staging | production
APP_ENV=local

# Laravel encryption key (signs cookies and the CSRF token), format
# "base64:<44 chars>". Generate: php artisan key:generate
# Its own key: it does not need to match the API's APP_KEY.
APP_KEY=

# true only while developing; false on any shared server.
APP_DEBUG=true

# Public base URL of this admin panel, no trailing slash, e.g. https://admin.example.com
APP_URL=http://localhost:8001

# PHP timezone, e.g. Asia/Kolkata
APP_TIMEZONE=Asia/Kolkata

# Version shown in the footer.
APP_VERSION=1.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ── Aira API ─────────────────────────────────────────────────────────────────

# Base URL of the Aira API (saathi-laravel-api), without /api/v1 and without a
# trailing slash, e.g. https://api.example.com or http://127.0.0.1:8000
AIRA_API_URL=YOUR_AIRA_API_URL

# Shared secret sent to the API in the X-Admin-Key header. It must equal
# ADMIN_API_KEY in the API's .env. Generate once and put the same value in
# both files: openssl rand -hex 32
ADMIN_API_KEY=YOUR_ADMIN_API_KEY

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# debug | info | warning | error
LOG_LEVEL=debug

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Only used for the admin's own sessions, cache and job queue (the sessions,
# cache and jobs tables). All Aira data is read through the API. Point it at the
# same Aira database as the API, e.g. aira_db
DB_CONNECTION=pgsql
# Database server host name or IP.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=YOUR_DATABASE_NAME
# A database user that can read and write the sessions, cache and jobs tables.
DB_USERNAME=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# The admin panel sends no email; "log" writes any mail to the log file.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── Remote logging (optional, TCM logger) ────────────────────────────────────
# true sends logs to the TCM logger; false turns it off. The values come from
# the logger's admin.
TCMLOGGER_DEBUG=false
TCMLOGGER_BASEURL=YOUR_TCMLOGGER_BASE_URL
TCMLOGGER_LOG_ENV=local
TCMLOGGER_CLIENT=YOUR_TCMLOGGER_CLIENT
TCMLOGGER_DOMAIN=YOUR_TCMLOGGER_DOMAIN
TCMLOGGER_APP=YOUR_TCMLOGGER_APP
TCMLOGGER_TOKEN=YOUR_TCMLOGGER_TOKEN
